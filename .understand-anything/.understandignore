# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)

# Minecraft server runtime data (not project source)
server/

# Modpack example assets (binary textures, not source code)
examples/

# Client runtime assets
client/

# Binary and generated files
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.zip
*.jar
*.mcpack
*.mrpack

# Chat logs and conversation dumps
hermes_conversation_*.json

# Lattice backups
.lattice.backup/
